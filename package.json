{
  "name": "coldsolutions-website",
  "version": "1.0.0",
  "private": true,
  "description": "ColdSolutions HVAC/R website — static HTML + Tailwind CSS v4",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "css": "tailwindcss -i src/input.css -o dist/styles.css --minify",
    "css:watch": "tailwindcss -i src/input.css -o dist/styles.css --watch",
    "build": "npm run vendor && npm run css",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "lenis": "1.3.26"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  }
}
